      <pdfd:claimData>
       <rdf:Bag>
        <rdf:li rdf:parseType="Resource">
         <pdfd:claimBy>LaTeX Project</pdfd:claimBy>
         <pdfd:claimDate>2025-08-25</pdfd:claimDate>
        </rdf:li>
       </rdf:Bag>
      </pdfd:claimData>
     </rdf:li>
    </rdf:Bag>
